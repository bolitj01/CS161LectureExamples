<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" prefHeight="295.0" prefWidth="466.0" spacing="10.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ComboBox.ComboBoxDemoController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="nameLbl" text="Name">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label fx:id="priceLbl" text="Price">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="addToCart" mnemonicParsing="false" style="-fx-border-color: green; -fx-border-width: 5px; -fx-background-color: lightgreen;" text="Add To Cart">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
</HBox>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" stylesheets="@TranslatorThesaurus.css" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exercise_solutions.TranslatorThesaurus.TranslatorThesaurusController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu text="File">
            <items>
              <MenuItem onAction="#save" text="Save" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <left>
      <VBox alignment="CENTER" prefHeight="375.0" prefWidth="480.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" styleClass="title" text="Translator" textAlignment="CENTER" />
            <TextArea fx:id="originalTA" prefHeight="200.0" prefWidth="200.0" styleClass="title">
               <VBox.margin>
                  <Insets top="40.0" />
               </VBox.margin>
            </TextArea>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#translate" text="Translate" />
                  <ComboBox fx:id="languageCB" prefHeight="45.0" prefWidth="185.0" promptText="Language">
                     <padding>
                        <Insets left="5.0" />
                     </padding></ComboBox>
               </children>
            </HBox>
            <TextArea fx:id="translatedTA" prefHeight="200.0" prefWidth="200.0" />
         </children>
         <BorderPane.margin>
            <Insets left="15.0" />
         </BorderPane.margin>
      </VBox>
   </left>
   <right>
      <VBox alignment="CENTER" prefHeight="375.0" prefWidth="480.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" styleClass="title" text="Thesaurus" textAlignment="CENTER" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="480.0" spacing="30.0">
               <children>
                  <TextField fx:id="wordTF" promptText="Enter a word" />
                  <Button mnemonicParsing="false" onAction="#getSynonyms" text="Get Synonyms" />
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </HBox>
            <ListView fx:id="synonymLV" prefHeight="440.0" prefWidth="480.0" />
         </children>
         <BorderPane.margin>
            <Insets right="15.0" />
         </BorderPane.margin>
      </VBox>
   </right>
</BorderPane>
